# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values

# ─── Firebase Core ───────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Enable Google Sign-In in your Firebase Console:
#   Firebase Console → Authentication → Sign-in method → Google → Enable
#
# Then add your OAuth 2.0 authorized domains in:
#   Firebase Console → Authentication → Settings → Authorized domains
#
# Also configure in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#   OAuth 2.0 Client ID → Authorized JavaScript origins → add your domain
#   OAuth 2.0 Client ID → Authorized redirect URIs → add your_project.firebaseapp.com/__/auth/handler
#
# The VITE_FIREBASE_AUTH_DOMAIN above is used automatically by Firebase's
# GoogleAuthProvider — no additional env var required.
